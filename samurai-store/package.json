{
  "name": "samurai-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-db.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:favorites": "node scripts/ensure-db.mjs && node scripts/setup-favorites-db.mjs",
